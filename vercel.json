{
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "ml/**",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/email-auth",
      "destination": "/api/email-auth.js"
    },
    {
      "source": "/api/social-auth",
      "destination": "/api/social-auth.js"
    },
    {
      "source": "/api/diary",
      "destination": "/api/diary.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
