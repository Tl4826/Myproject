{
  "framework": null,
  "buildCommand": "mkdir -p ai-public",
  "outputDirectory": "ai-public",
  "functions": {
    "api/index.py": {
      "includeFiles": "ml/**",
      "excludeFiles": "ml/models/**",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index?__nutrivn_route=health"
    },
    {
      "source": "/api/predict",
      "destination": "/api/index?__nutrivn_route=predict"
    }
  ]
}
