# Chạy local với API khác: sao chép file này thành .env.development.local (chỉ áp dụng cho `npm run dev`)
# Deploy: đặt NEXT_PUBLIC_API_URL trong phần Environment Variables của nơi build (ưu tiên hơn file .env)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: leave empty until configured and approved by the team.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN belongs in the root server environment / Vercel, not the browser.
